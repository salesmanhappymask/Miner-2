local CAIRN_STATE_FILE="cairn_rm.cfg"

local function readTable(path)
    if not fs.exists(path) then return nil end
    local h=fs.open(path,"r")
    if not h then return nil end
    local raw=h.readAll()
    h.close()
    local ok,value=pcall(textutils.unserialize,raw)
    if not ok or type(value)~="table" then return nil end
    return value
end

local function writeTable(path,value)
    local h=fs.open(path,"w")
    if not h then return false end
    h.write(textutils.serialize(value))
    h.close()
    return true
end

local state=readTable("regional_manager.tmp")

if state and type(state.recall)=="table" and
    state.recall.state~="PACK_COMPLETE" then
    print("Cairn dock mode refused.")
    print("Regional Manager still has live quarry state:")
    print(tostring(state.recall.state))
    print("Pack the swarm first.")
    return
end

local cfg={
    schema=1,
    docked=true,
    phase="DOCKED",
    dir=0
}

if not writeTable(CAIRN_STATE_FILE,cfg) then
    error("Could not write "..CAIRN_STATE_FILE)
end

print("Cairn dock mode enabled.")
print("Regional Manager will wait for Drive1 / 2701.")
print("Reboot when ready.")
