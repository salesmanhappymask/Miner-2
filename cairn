local function queueControl(message)
    if type(message) ~= "table" then
        return
    end

    controlQueue[#controlQueue + 1] = message
end

local function queueQuarry(sender, message)
    if type(message) ~= "table" then
        return
    end

    quarryQueue[#quarryQueue + 1] = {
        sender = sender,
        message = message
    }
end

local function waitLinkType(expected, token, timeout)
    local deadline = os.clock() + timeout

    while os.clock() < deadline do
        local remaining = deadline - os.clock()
        local sender, message = rednet.receive(LINK_PROTOCOL, remaining)

        if not sender then
            return nil
        end

        if sender == SLAVE_ID and type(message) == "table" then
            if
                message.type == "control_relay" and
                type(message.message) == "table"
            then
                queueControl(message.message)

            elseif
                message.type == "quarry_relay" and
                type(message.message) == "table"
            then
                queueQuarry(message.sender, message.message)

            elseif message.type == expected then
                if token == nil or message.token == token then
                    return message
                end
            end
        end
    end

    return nil
end

local function pingSlaveOnce()
    local token =
        "ping:" ..
        tostring(os.getComputerID()) ..
        ":" ..
        tostring(math.floor(os.clock() * 1000))

    rednet.send(SLAVE_ID, {
        type = "ping",
        token = token
    }, LINK_PROTOCOL)

    return waitLinkType("pong", token, LINK_TIMEOUT)
end

local function pingSlave()
    for attempt = 1, LINK_ATTEMPTS do
        local reply = pingSlaveOnce()

        if reply then
            return reply
        end

        sleep(0.05)
    end

    return nil
end

local function prepareSlave(tx)
    for attempt = 1, LINK_ATTEMPTS do
        rednet.send(SLAVE_ID, {
            type = "prepare",
            token = tx.token,
            direction = tx.direction,
            executor = tx.owner
        }, LINK_PROTOCOL)

        local reply = waitLinkType("prepared", tx.token, LINK_TIMEOUT)

        if reply then
            return true
        end

        sleep(0.05)
    end

    return false
end

local function querySlaveTx(token)
    rednet.send(SLAVE_ID, {
        type = "tx_status",
        token = token
    }, LINK_PROTOCOL)

    return waitLinkType("tx_status", token, LINK_TIMEOUT)
end

local function commitSlave(token)
    rednet.send(SLAVE_ID, {
        type = "commit",
        token = token
    }, LINK_PROTOCOL)

    waitLinkType("commit_ack", token, 0.75)
end

local function pulseMain(side)
    clearMainOutputs()
    redstone.setOutput(side, true)
    sleep(PULSE_TIME)
    redstone.setOutput(side, false)
    sleep(MOVE_SETTLE_TIME)
end

local function physicalMoveFailed(state, reason)
    local tx = state.tx
    local move = tx and moves[tx.direction] or nil
    local detail =
        "direction=" .. tostring(tx and tx.direction or "unknown") ..
        " owner=" .. tostring(move and move.owner or "unknown") ..
        " side=" .. tostring(move and move.side or "unknown") ..
        " current=" .. positionText(state.current) ..
        " reason=" .. tostring(reason)

    logEvent("ERROR", "PHYSICAL_MOVE_FAILED", detail)

    state.lastMoveError = tostring(reason)
    state.tx = nil
    state.paused = true
    saveMainState(state)

    drawRoute(state)
    print("")
    print("Position was NOT advanced.")
    print("Route paused. Fix the drive and Resume.")

    return false
end

local function commitMove(state)
    local tx = state.tx

    if not tx then
        return false
    end

    local move = moves[tx.direction]

    if not move then
        return false
    end

    local before = positionText(state.current)

    state.current.x = state.current.x + move.dx
    state.current.y = state.current.y + move.dy
    state.current.z = state.current.z + move.dz

    local token = tx.token
    local direction = tx.direction

    state.tx = nil
    state.lastMoveError = nil

    saveMainState(state)
    commitSlave(token)

    logEvent(
        "INFO",
        "MOVE_COMMIT",
        "token=" .. tostring(token) ..
        " direction=" .. tostring(direction) ..
        " from=" .. before ..
        " to=" .. positionText(state.current) ..
        " stage=" .. tostring(state.stage)
    )

    drawRoute(state)

    return true
end

local function recoveryFailure(state, message)
    local tx = state.tx

    if not tx then
        return
    end

    logEvent(
        "ERROR",
        "MOVE_RECOVERY",
        "token=" .. tostring(tx.token) ..
        " direction=" .. tostring(tx.direction) ..
        " phase=" .. tostring(tx.phase) ..
        " current=" .. positionText(state.current) ..
        " message=" .. tostring(message)
    )

    tx.recoveryReboots = (tx.recoveryReboots or 0) + 1
    saveMainState(state)

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN MOVEMENT RECOVERY")
    print("")
    print(message)
    print("")
    print(
        "Automatic recovery reboot " ..
        tx.recoveryReboots ..
        "/" ..
        MAX_RECOVERY_REBOOTS
    )

    if tx.recoveryReboots <= MAX_RECOVERY_REBOOTS then
        sleep(1.5)
        os.reboot()
        return
    end

    print("")
    print("Automatic recovery limit reached.")
    print("Press Enter to retry recovery.")
    print("Type CANCEL to discard the trip.")

    local answer = string.lower(read() or "")

    if answer == "cancel" then
        if fs.exists(MAIN_STATE_FILE) then
            fs.delete(MAIN_STATE_FILE)
        end
        os.reboot()
        return
    end

    tx.recoveryReboots = 0
    saveMainState(state)
    os.reboot()
end

local function confirmLocalMove(state)
    local tx = state.tx

    for attempt = 1, LINK_ATTEMPTS do
        local reply = querySlaveTx(tx.token)

        if reply and reply.present == true then
            return commitMove(state)
        end

        sleep(0.1)
    end

    recoveryFailure(
        state,
        "Drive1 slave did not check in after Drive2 movement."
    )

    return false
end

local function sendSlaveExecute(tx)
    logEvent(
        "INFO",
        "REMOTE_EXECUTE_SEND",
        "token=" .. tostring(tx.token) ..
        " direction=" .. tostring(tx.direction)
    )
    rednet.send(SLAVE_ID, {
        type = "execute",
        token = tx.token,
        direction = tx.direction
    }, LINK_PROTOCOL)
end

local function confirmSlaveMove(state)
    local tx = state.tx

    for attempt = 1, LINK_ATTEMPTS do
        local reply = querySlaveTx(tx.token)

        if reply and reply.present == true then
            if reply.phase == "complete" then
                return commitMove(state)
            end

            if reply.phase == "prepared" then
                sendSlaveExecute(tx)
            end
        else
            if pingSlaveOnce() then
                if prepareSlave(tx) then
                    sendSlaveExecute(tx)
                end
            end
        end

        sleep(0.1)
    end

    recoveryFailure(
        state,
        "Drive1 slave did not confirm its movement transaction."
    )

    return false
end

local function runTransaction(state)
    local tx = state.tx

    if not tx then
        return false
    end

    local move = moves[tx.direction]

    if not move then
        recoveryFailure(state, "Unknown movement transaction.")
        return false
    end

    drawRoute(state, tx.direction)

    if tx.phase == "created" then
        if not prepareSlave(tx) then
            recoveryFailure(
                state,
                "Drive1 slave did not prepare the movement transaction."
            )
            return false
        end

        tx.phase = "prepared"
        saveMainState(state)
    end

    if move.owner == MASTER_ID then
        if tx.phase == "prepared" then
            tx.phase = "local_issued"
            saveMainState(state)

            logEvent(
                "INFO",
                "LOCAL_PULSE",
                "token=" .. tostring(tx.token) ..
                " direction=" .. tostring(tx.direction) ..
                " side=" .. tostring(move.side) ..
                " current=" .. positionText(state.current)
            )

            pulseMain(move.side)
            sleep(PHYSICAL_MOVE_TIMEOUT)

            return physicalMoveFailed(
                state,
                "Drive2 remained online after the movement pulse"
            )
        end

        if tx.phase == "local_issued" or tx.phase == "await_peer" then
            return confirmLocalMove(state)
        end

    else
        if tx.phase == "prepared" then
            tx.phase = "remote_issued"
            saveMainState(state)
            sendSlaveExecute(tx)
            sleep(PHYSICAL_MOVE_TIMEOUT)

            return physicalMoveFailed(
                state,
                "Drive2 remained online after Drive1 executed the movement"
            )
        end

        if tx.phase == "remote_issued" then
            return confirmSlaveMove(state)
        end
    end

    recoveryFailure(state, "Invalid transaction phase: " .. tostring(tx.phase))
    return false
end

local function newMove(state, direction)
    local move = moves[direction]

    if not move then
        recoveryFailure(state, "Invalid direction: " .. tostring(direction))
        return
    end

    state.sequence = (state.sequence or 0) + 1

    state.tx = {
        token =
            tostring(MASTER_ID) ..
            ":" ..
            tostring(state.sequence) ..
            ":" ..
            direction,
        direction = direction,
        owner = move.owner,
        phase = "created",
        recoveryReboots = 0
    }

    logEvent(
        "INFO",
        "MOVE_CREATE",
        "token=" .. tostring(state.tx.token) ..
        " direction=" .. tostring(direction) ..
        " owner=" .. tostring(move.owner) ..
        " side=" .. tostring(move.side) ..
        " current=" .. positionText(state.current) ..
        " destination=" .. positionText(state.destination) ..
        " stage=" .. tostring(state.stage)
    )

    saveMainState(state)
    runTransaction(state)
end


local function integerValue(value)
    local number = tonumber(value)

    if not number or number ~= math.floor(number) then
        return nil
    end

    return number
end

local function copyPosition(value)
    if type(value) ~= "table" then
        return nil
    end

    return {
        x = value.x,
        y = value.y,
        z = value.z
    }
end

local function gridPoint(value)
    return
        type(value) == "table" and
        type(value.x) == "number" and
        type(value.z) == "number"
end

local function targetChunkSouthWest(position, gridSouthWest)
    if type(position) ~= "table" or not gridPoint(gridSouthWest) then
        return nil
    end

    local chunkX = math.floor((position.x - gridSouthWest.x) / 16)
    local chunkZ = math.ceil((position.z - gridSouthWest.z) / 16)

    return {
        x = gridSouthWest.x + chunkX * 16,
        z = gridSouthWest.z + chunkZ * 16,
        deltaX = chunkX,
        deltaZ = chunkZ
    }
end

local function quarryGeometry(position, quarry)
    local southWest = quarry and quarry.targetChunkSouthWest or nil

    if not gridPoint(southWest) then
        return nil
    end

    local groundY = position.y - 3
    local worldOrigin = {
        x = southWest.x - 1,
        y = groundY,
        z = southWest.z
    }
    local seed = {
        x = worldOrigin.x,
        y = groundY,
        z = worldOrigin.z + 1
    }
    local dock = {
        x = position.x,
        y = position.y + 1,
        z = position.z - 4
    }

    return {
        cairn = copyPosition(position),
        routeStart = copyPosition(quarry.routeStart),
        gridSouthWest = {
            x = quarry.gridSouthWest.x,
            z = quarry.gridSouthWest.z
        },
        drive1 = {
            x = position.x,
            y = position.y,
            z = position.z - 4
        },
        dock = dock,
        clear = {
            x = seed.x,
            y = position.y + 2,
            z = seed.z
        },
        seed = seed,
        idle = {
            x = worldOrigin.x + 6,
            y = groundY,
            z = worldOrigin.z + 3
        },
        worldOrigin = worldOrigin,
        chunk = {
            southWest = {
                x = southWest.x,
                z = southWest.z
            },
            startSouthWest = {
                x = quarry.startChunkSouthWest.x,
                z = quarry.startChunkSouthWest.z
            },
            offsetX = position.x - southWest.x,
            offsetZ = southWest.z - position.z,
            deltaX = (southWest.x - quarry.startChunkSouthWest.x) / 16,
            deltaZ = (southWest.z - quarry.startChunkSouthWest.z) / 16
        }
    }
end

local function quarryCommitted(state)
    if not state.quarry then
        return false
    end

    local phase = tostring(state.quarry.phase or "")

    return
        phase ~= "" and
        phase ~= "TRAVEL" and
        phase ~= "CONTACT" and
        phase ~= "READY"
end

local function routeActive(state)
    return
        state.stage ~= "idle" and
        state.stage ~= "arrived" and
        state.stage ~= "complete"
end

local function controlStatus(state)
    return {
        type = "status",
        ok = true,
        current = copyPosition(state.current),
        destination = copyPosition(state.destination),
        origin = copyPosition(state.start),
        cruise = state.cruise,
        stage = state.stage,
        routeMode = state.routeMode,
        paused = state.paused == true,
        active = routeActive(state),
        transaction = state.tx and {
            direction = state.tx.direction,
            phase = state.tx.phase
        } or nil,
        movementError = state.lastMoveError,
        quarry = state.quarry and {
            phase = state.quarry.phase,
            rmId = state.quarry.rmId,
            jobToken = state.quarry.jobToken,
            error = state.quarry.error
        } or nil
    }
end

local function sendControlReply(token, payload)
    payload = payload or {}
    payload.token = token
    payload.release = CAIRN_RELEASE

    rednet.send(
        SLAVE_ID,
        {
            type = "control_reply",
            token = token,
            payload = payload
        },
        LINK_PROTOCOL
    )
end

local function cacheControlReply(state, token, payload)
    state.lastControlToken = token
    state.lastControlReply = payload
    saveMainState(state)
end

local function beginOneWay(state, x, y, z, cruise)
    state.start = copyPosition(state.current)
    state.destination = {
        x = x,
        y = y,
        z = z
    }
    state.cruise = cruise
    state.stage = "out_climb"
    state.routeMode = "oneway"
    state.paused = false
    state.tx = nil
    state.quarry = nil
    state.lastMoveError = nil
    saveMainState(state)
    logEvent(
        "INFO",
        "ROUTE_BEGIN",
        "mode=oneway start=" .. positionText(state.start) ..
        " destination=" .. positionText(state.destination) ..
        " cruise=" .. tostring(state.cruise)
    )
end

local function beginQuarry(state, x, y, z, cruise, gridSouthWest)
    state.quarrySequence = (tonumber(state.quarrySequence) or 0) + 1
    state.start = copyPosition(state.current)
    state.destination = {
        x = x,
        y = y,
        z = z
    }
    state.cruise = cruise
    state.stage = "out_climb"
    state.routeMode = "quarry"
    state.paused = false
    state.tx = nil
    state.lastMoveError = nil

    local startSouthWest = targetChunkSouthWest(
        state.start,
        gridSouthWest
    )
    local targetSouthWest = targetChunkSouthWest(
        state.destination,
        gridSouthWest
    )

    state.quarry = {
        phase = "TRAVEL",
        jobToken =
            "quarry:" ..
            tostring(MASTER_ID) ..
            ":" ..
            tostring(state.quarrySequence),
        routeStart = copyPosition(state.start),
        gridSouthWest = {
            x = gridSouthWest.x,
            z = gridSouthWest.z
        },
        startChunkSouthWest = startSouthWest,
        targetChunkSouthWest = targetSouthWest
    }
    saveMainState(state)
    logEvent(
        "INFO",
        "ROUTE_BEGIN",
        "mode=quarry start=" .. positionText(state.start) ..
        " destination=" .. positionText(state.destination) ..
        " cruise=" .. tostring(state.cruise) ..
        " startChunkSW=" .. tostring(startSouthWest.x) .. "," .. tostring(startSouthWest.z) ..
        " targetChunkSW=" .. tostring(targetSouthWest.x) .. "," .. tostring(targetSouthWest.z) ..
        " job=" .. tostring(state.quarry.jobToken)
    )
end

local function handleControl(state, message)
    local token = tostring(message.token or "")
    local command = tostring(message.command or "")

    if token == "" then
        return
    end

    if
        state.lastControlToken == token and
        state.lastControlReply
    then
        sendControlReply(
            token,
            state.lastControlReply
        )
        return
    end

    if command == "status" then
        local payload = controlStatus(state)
        cacheControlReply(state, token, payload)
        sendControlReply(token, payload)
        return
    end

    local reply = {
        type = "command_reply",
        command = command,
        ok = false
    }

    logEvent(
        "INFO",
        "CONTROL",
        "command=" .. tostring(command) ..
        " token=" .. tostring(token) ..
        " current=" .. positionText(state.current) ..
        " stage=" .. tostring(state.stage)
    )

    if command == "pause" then
        state.paused = true
        reply.ok = true
        reply.message = "Route paused"

    elseif command == "resume" then
        if routeActive(state) then
            state.paused = false
            state.lastMoveError = nil
            reply.ok = true
            reply.message = "Route resumed"
        else
            reply.message = "No active route"
        end

    elseif command == "cancel" then
        if quarryCommitted(state) then
            reply.message = "Quarry is deployed; cancel is locked until the RM returns"
        else
            state.paused = false
            state.stage = "idle"
            state.routeMode = "idle"
            state.tx = nil
            state.quarry = nil
            state.lastMoveError = nil
            reply.ok = true
            reply.message = "Route cancelled"
        end

    elseif command == "set_destination" then
        local x = integerValue(message.x)
        local y = integerValue(message.y)
        local z = integerValue(message.z)
        local cruise = integerValue(message.cruise)

        if not x or not y or not z or not cruise then
            reply.message = "Coordinates must be whole numbers"

        elseif cruise < state.current.y or cruise < y then
            reply.message = "Cruise Y is too low"

        else
            beginOneWay(
                state,
                x,
                y,
                z,
                cruise
            )

            reply.ok = true
            reply.message = "Destination accepted"
        end

    elseif command == "quarry" then
        local x = integerValue(message.x)
        local y = integerValue(message.y)
        local z = integerValue(message.z)
        local cruise = integerValue(message.cruise)
        local gridX = integerValue(message.gridX)
        local gridZ = integerValue(message.gridZ)
        local gridSouthWest = gridX and gridZ and {
            x = gridX,
            z = gridZ
        } or nil

        if routeActive(state) or state.tx then
            reply.message = "Finish or cancel the active route first"

        elseif not x or not y or not z or not cruise then
            reply.message = "Coordinates must be whole numbers"

        elseif not gridSouthWest then
            reply.message = "Set the controller CHUNK GRID first"

        elseif cruise < state.current.y or cruise < y then
            reply.message = "Cruise Y is too low"

        else
            beginQuarry(
                state,
                x,
                y,
                z,
                cruise,
                gridSouthWest
            )

            local sw = state.quarry.targetChunkSouthWest
            reply.ok = true
            reply.message =
                "Quarry route accepted; target chunk SW " ..
                tostring(sw.x) .. "," .. tostring(sw.z)
        end

    elseif command == "return_origin" then
        if quarryCommitted(state) then
            reply.message = "Quarry is deployed; Cairn will return after pack-up"

        elseif not state.start then
            reply.message = "No origin stored"

        else
            local cruise =
                integerValue(message.cruise) or
                state.cruise or
                state.current.y

            if
                cruise < state.current.y or
                cruise < state.start.y
            then
                reply.message = "Cruise Y is too low"

            else
                beginOneWay(
                    state,
                    state.start.x,
                    state.start.y,
                    state.start.z,
                    cruise
                )

                reply.ok = true
                reply.message = "Return route accepted"
            end
        end

    elseif command == "set_position" then
        local x = integerValue(message.x)
        local y = integerValue(message.y)
        local z = integerValue(message.z)

        if routeActive(state) or state.tx then
            reply.message = "Cancel route before setting position"

        elseif not x or not y or not z then
            reply.message = "Coordinates must be whole numbers"

        else
            state.current = {
                x = x,
                y = y,
                z = z
            }

            state.start = copyPosition(state.current)
            state.destination = copyPosition(state.current)
            state.cruise = y
            state.stage = "idle"
            state.routeMode = "idle"
            state.paused = false
            state.lastMoveError = nil

            reply.ok = true
            reply.message = "Position updated"
        end

    elseif command == "force_update" then
        if quarryCommitted(state) then
            reply.message = "Update locked while Regional Manager is deployed"
        else
            state.paused = true
            reply.ok = true
            reply.message = "Platform update starting"
            pendingAction = "update"
        end

    else
        reply.message = "Unknown command"
    end

    cacheControlReply(state, token, reply)
    sendControlReply(token, reply)
end

local function processControlQueue(state)
    while #controlQueue > 0 do
        local message = table.remove(
            controlQueue,
            1
        )

        handleControl(state, message)
    end
end

local function sendQuarryWireless(message, target)
    rednet.send(
        SLAVE_ID,
        {
            type = "quarry_wireless",
            target = target,
            message = message
        },
        LINK_PROTOCOL
    )
end

local function processQuarryQueue(state)
    local changed = false

    while #quarryQueue > 0 do
        local entry = table.remove(quarryQueue, 1)
        local sender = entry.sender
        local message = entry.message

        if
            state.quarry and
            type(message) == "table" and
            tostring(message.jobToken or "") ==
                tostring(state.quarry.jobToken or "")
        then
            local kind = tostring(message.type or "")

            if kind == "quarry_ready" then
                state.quarry.rmId =
                    tonumber(message.rmId) or
                    tonumber(sender)

                state.quarry.phase = "READY"
                state.stage = "quarry_launch"
                changed = true

            elseif kind == "quarry_launch_ack" then
                state.quarry.rmId =
                    tonumber(message.rmId) or
                    state.quarry.rmId or
                    tonumber(sender)

                state.quarry.phase = "UNDOCKING"
                state.stage = "quarry_wait"
                changed = true

            elseif kind == "quarry_status" then
                state.quarry.rmId =
                    tonumber(message.rmId) or
                    state.quarry.rmId or
                    tonumber(sender)

                if message.phase then
                    state.quarry.phase =
                        tostring(message.phase)
                end

                state.quarry.error = message.error
                changed = true

            elseif kind == "quarry_complete" then
                state.quarry.rmId =
                    tonumber(message.rmId) or
                    state.quarry.rmId or
                    tonumber(sender)

                state.quarry.phase = "DOCKED"
                state.quarry.error = nil
                state.stage = "return_climb"
                state.routeMode = "quarry_return"
                state.paused = false
                changed = true

            elseif kind == "quarry_error" then
                state.quarry.rmId =
                    tonumber(message.rmId) or
                    state.quarry.rmId or
                    tonumber(sender)

                state.quarry.phase = "ERROR"
                state.quarry.error =
                    tostring(message.error or "Regional Manager error")

                state.paused = true
                changed = true
            end
        end
    end

    if changed then
        saveMainState(state)
    end
end

local function receiveControlRelay(timeout)
    local sender, message = rednet.receive(
        LINK_PROTOCOL,
        timeout
    )

    if
        sender == SLAVE_ID and
        type(message) == "table"
    then
        if
            message.type == "control_relay" and
            type(message.message) == "table"
        then
            queueControl(message.message)
            return true

        elseif
            message.type == "quarry_relay" and
            type(message.message) == "table"
        then
            queueQuarry(message.sender, message.message)
            return true
        end
    end

    return false
end

local function controlCheckpoint(state)
    local token =
        "scan:" ..
        tostring(MASTER_ID) ..
        ":" ..
        tostring(math.floor(os.clock() * 1000))

    rednet.send(
        SLAVE_ID,
        {
            type = "control_scan",
            token = token,
            duration = CONTROL_WINDOW
        },
        LINK_PROTOCOL
    )

    local reply = waitLinkType(
        "control_scan_done",
        token,
        CONTROL_WINDOW + 0.9
    )

    processControlQueue(state)
    processQuarryQueue(state)

    if not reply then
        return false
    end

    if pendingAction then
        return false
    end

    if state.paused then
        return false
    end

    return true
end

local function moveYTo(state, target)
    if state.current.y < target then
        newMove(state, "up")
        return true
    end

    if state.current.y > target then
        newMove(state, "down")
        return true
    end

    return false
end

local function moveXTo(state, target)
    if state.current.x < target then
        newMove(state, "left")
        return true
    end

    if state.current.x > target then
        newMove(state, "right")
        return true
    end

    return false
end

local function moveZTo(state, target)
    if state.current.z > target then
        newMove(state, "forward")
        return true
    end

    if state.current.z < target then
        newMove(state, "back")
        return true
    end

    return false
end

local function waitForSlaveInteractive()
    while true do
        term.clear()
        term.setCursorPos(1, 1)
        print("CAIRN DRIVE PREFLIGHT")
        print("Release v" .. CAIRN_RELEASE)
        print("")
        print("Checking Drive1 / 2701...")

        local reply = pingSlave()

        if reply then
            print("Drive1 slave online")
            print("Drive1 slave release: v" .. tostring(reply.release))
            sleep(0.75)
            return
        end

        print("")
        print("Drive1 did not answer.")
        print("Press Enter to retry.")
        read()
    end
end

local function initializeState()
    waitForSlaveInteractive()

    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN NAVIGATION")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Enter authoritative current coordinates")

    local x = askInteger("X")
    local y = askInteger("Y")
    local z = askInteger("Z")

    local state = {
        version = MAIN_STATE_VERSION,
        start = {
            x = x,
            y = y,
            z = z
        },
        destination = {
            x = x,
            y = y,
            z = z
        },
        cruise = y,
        current = {
            x = x,
            y = y,
            z = z
        },
        stage = "idle",
        routeMode = "idle",
        paused = false,
        sequence = 0,
        tx = nil,
        lastControlToken = nil,
        lastControlReply = nil,
        quarrySequence = 0,
        quarry = nil,
        lastMoveError = nil
    }

    saveMainState(state)

    return state
end

local function advanceTrip(state)
    if state.tx then
        runTransaction(state)
        return
    end

    if state.paused then
        return
    end

    while true do
        processQuarryQueue(state)

        if state.stage == "idle" or state.stage == "arrived" then
            return
        end

        if state.stage == "quarry_contact" then
            local geometry = quarryGeometry(state.current, state.quarry)

            sendQuarryWireless({
                type = "quarry_prepare",
                version = 2,
                jobToken = state.quarry.jobToken,
                cairn = geometry.cairn,
                drive1 = geometry.drive1,
                dock = geometry.dock,
                clear = geometry.clear,
                seed = geometry.seed,
                idle = geometry.idle,
                routeStart = geometry.routeStart,
                gridSouthWest = geometry.gridSouthWest,
                worldOrigin = geometry.worldOrigin,
                chunk = geometry.chunk
            })

            waitLinkType(
                "__quarry_wait__",
                nil,
                0.30
            )

            processQuarryQueue(state)
            return
        end

        if state.stage == "quarry_launch" then
            local geometry = quarryGeometry(state.current, state.quarry)

            sendQuarryWireless({
                type = "quarry_launch",
                version = 2,
                jobToken = state.quarry.jobToken,
                cairn = geometry.cairn,
                drive1 = geometry.drive1,
                dock = geometry.dock,
                clear = geometry.clear,
                seed = geometry.seed,
                idle = geometry.idle,
                routeStart = geometry.routeStart,
                gridSouthWest = geometry.gridSouthWest,
                worldOrigin = geometry.worldOrigin,
                chunk = geometry.chunk
            }, state.quarry.rmId)

            waitLinkType(
                "__quarry_wait__",
                nil,
                0.30
            )

            processQuarryQueue(state)
            return
        end

        if state.stage == "quarry_wait" then
            sendQuarryWireless({
                type = "quarry_status_query",
                version = 2,
                jobToken = state.quarry.jobToken
            }, state.quarry.rmId)

            waitLinkType(
                "__quarry_wait__",
                nil,
                0.50
            )

            processQuarryQueue(state)
            return
        end

        if not controlCheckpoint(state) then
            return
        end

        if state.stage == "out_climb" then
            if moveYTo(state, state.cruise) then
                return
            end

            state.stage = "out_x"
            saveMainState(state)

        elseif state.stage == "out_x" then
            if moveXTo(state, state.destination.x) then
                return
            end

            state.stage = "out_z"
            saveMainState(state)

        elseif state.stage == "out_z" then
            if moveZTo(state, state.destination.z) then
                return
            end

            state.stage = "out_descend"
            saveMainState(state)

        elseif state.stage == "out_descend" then
            if moveYTo(state, state.destination.y) then
                return
            end

            if state.routeMode == "oneway" then
                state.stage = "arrived"
                state.routeMode = "idle"
                state.paused = false
                saveMainState(state)
                return

            elseif state.routeMode == "quarry" then
                state.stage = "quarry_contact"
                state.quarry.phase = "CONTACT"
                state.paused = false
                saveMainState(state)
                return
            end

            state.stage = "dwell"
            saveMainState(state)

        elseif state.stage == "dwell" then
            local remaining = 10

            while remaining > 0 do
                receiveControlRelay(0.20)
                processControlQueue(state)

                if pendingAction or state.paused then
                    return
                end

                remaining = remaining - 0.20
            end

            state.stage = "return_climb"
            saveMainState(state)

        elseif state.stage == "return_climb" then
            if moveYTo(state, state.cruise) then
                return
            end

            state.stage = "return_x"
            saveMainState(state)

        elseif state.stage == "return_x" then
            if moveXTo(state, state.start.x) then
                return
            end

            state.stage = "return_z"
            saveMainState(state)

        elseif state.stage == "return_z" then
            if moveZTo(state, state.start.z) then
                return
            end

            state.stage = "return_descend"
            saveMainState(state)

        elseif state.stage == "return_descend" then
            if moveYTo(state, state.start.y) then
                return
            end

            state.stage = "arrived"
            state.routeMode = "idle"
            state.paused = false

            if state.quarry then
                state.quarry.phase = "RETURNED"
            end

            saveMainState(state)
            return

        elseif state.stage == "complete" then
            state.stage = "arrived"
            state.routeMode = "idle"
            state.paused = false
            saveMainState(state)
            return

        else
            term.clear()
            term.setCursorPos(1, 1)
            print("CAIRN NAVIGATION")
            print("")
            print("Unknown route stage: " .. tostring(state.stage))
            print("Delete " .. MAIN_STATE_FILE .. " to reset.")
            return
        end
    end
end

local function receiveRemoteUpdate(firstMessage)
    local session = firstMessage.session
    local version = firstMessage.version
    local expected = firstMessage.files

    if
        type(session) ~= "string" or
        type(version) ~= "number" or
        type(expected) ~= "table"
    then
        return false, "invalid update begin"
    end

    local stage = "cairn_remote_stage"

    if fs.exists(stage) then
        fs.delete(stage)
    end

    fs.makeDir(stage)

    rednet.send(MASTER_ID, {
        type = "update_ack",
        stage = "begin",
        session = session
    }, UPDATE_PROTOCOL)

    local received = {}

    while true do
        local sender, message, protocol = rednet.receive()

        if
            sender == MASTER_ID and
            protocol == UPDATE_PROTOCOL and
            type(message) == "table" and
            message.session == session
        then
            if message.type == "file_begin" then
                local name = message.name

                if type(name) ~= "string" then
                    return false, "invalid file name"
                end

                local path = fs.combine(stage, name)

                if fs.exists(path) then
                    fs.delete(path)
                end

                local h = fs.open(path, "w")

                if not h then
                    return false, "could not create staged file"
                end

                h.close()
                received[name] = true

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "file_begin",
                    session = session,
                    name = name
                }, UPDATE_PROTOCOL)

            elseif message.type == "file_chunk" then
                local name = message.name
                local data = message.data

                if not received[name] or type(data) ~= "string" then
                    return false, "invalid file chunk"
                end

                local h = fs.open(fs.combine(stage, name), "a")

                if not h then
                    return false, "could not append staged file"
                end

                h.write(data)
                h.close()

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "file_chunk",
                    session = session,
                    name = name,
                    index = message.index
                }, UPDATE_PROTOCOL)

            elseif message.type == "file_end" then
                local name = message.name
                local path = fs.combine(stage, name)
                local fn, err = loadfile(path)

                if not fn then
                    return false, "validation failed: " .. tostring(err)
                end

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "file_end",
                    session = session,
                    name = name
                }, UPDATE_PROTOCOL)

            elseif message.type == "commit" then
                for _, name in ipairs(expected) do
                    if
                        not received[name] or
                        not fs.exists(fs.combine(stage, name))
                    then
                        return false, "missing staged file: " .. tostring(name)
                    end
                end

                local rootDrive = fs.getDrive("")

                for _, name in ipairs(fs.list("")) do
                    local okDrive, drive = pcall(fs.getDrive, name)
                    local writable = okDrive and drive == rootDrive and not fs.isReadOnly(name)

                    if writable and name ~= stage then
                        local ok, err = pcall(fs.delete, name)

                        if not ok or fs.exists(name) then
                            return false, "could not clear " .. name .. ": " .. tostring(err or "delete failed")
                        end
                    end
                end

                for _, name in ipairs(expected) do
                    local source = fs.combine(stage, name)
                    fs.move(source, name)
                end

                if fs.exists(stage) then
                    fs.delete(stage)
                end

                local h = fs.open("cairn_version", "w")

                if h then
                    h.write(tostring(version))
                    h.close()
                end

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "commit",
                    session = session
                }, UPDATE_PROTOCOL)

                sleep(0.5)
                os.reboot()

                return true
            end
        end
    end
end

local function slaveReply(state, messageType, token, extra)
    local payload = extra or {}

    payload.type = messageType
    payload.token = token
    payload.release = CAIRN_RELEASE
    payload.boot = state.boot

    rednet.send(MASTER_ID, payload, LINK_PROTOCOL)
end

local function slaveStatus(state, token)
    local present =
        state.tx ~= nil and
        state.tx.token == token

    slaveReply(
        state,
        "tx_status",
        token,
        {
            present = present,
            phase = present and state.tx.phase or nil,
            direction = present and state.tx.direction or nil,
            executor = present and state.tx.executor or nil
        }
    )
end

local function relayControllerMessage(message)
    if type(message) ~= "table" then
        return
    end

    local token = tostring(message.token or "")

    if token == "" then
        return
    end

    rednet.send(
        CONTROL_ID,
        {
            type = "relay_ack",
            token = token,
            release = CAIRN_RELEASE,
            message = "Drive1 received command"
        },
        CONTROL_REPLY_PROTOCOL
    )

    rednet.send(
        MASTER_ID,
        {
            type = "control_relay",
            message = message
        },
        LINK_PROTOCOL
    )
end

local function forwardControllerReply(message)
    if
        type(message) == "table" and
        type(message.payload) == "table"
    then
        rednet.send(
            CONTROL_ID,
            message.payload,
            CONTROL_REPLY_PROTOCOL
        )
    end
end

local function relayQuarryMessage(sender, message)
    if type(message) ~= "table" then
        return
    end

    rednet.send(
        MASTER_ID,
        {
            type = "quarry_relay",
            sender = sender,
            message = message
        },
        LINK_PROTOCOL
    )
end

local function sendQuarryFromSlave(message)
    if
        type(message) ~= "table" or
        type(message.message) ~= "table"
    then
        return
    end

    local target = tonumber(message.target)

    if target then
        rednet.send(
            target,
            message.message,
            QUARRY_PROTOCOL
        )
    else
        rednet.broadcast(
            message.message,
            QUARRY_PROTOCOL
        )
    end
end

local function scanController(duration)
    local deadline = os.clock() + duration

    while os.clock() < deadline do
        local sender, message, protocol = rednet.receive(
            nil,
            deadline - os.clock()
        )

        if not sender then
            break
        end

        if
            sender == CONTROL_ID and
            protocol == CONTROL_PROTOCOL and
            type(message) == "table"
        then
            relayControllerMessage(message)

        elseif
            protocol == QUARRY_PROTOCOL and
            type(message) == "table"
        then
            relayQuarryMessage(sender, message)

        elseif
            sender == MASTER_ID and
            protocol == UPDATE_PROTOCOL and
            type(message) == "table" and
            message.type == "update_begin"
        then
            receiveRemoteUpdate(message)

        elseif
            sender == MASTER_ID and
            protocol == LINK_PROTOCOL and
            type(message) == "table" and
            message.type == "control_reply"
        then
            forwardControllerReply(message)

        elseif
            sender == MASTER_ID and
            protocol == LINK_PROTOCOL and
            type(message) == "table" and
            message.type == "quarry_wireless"
        then
            sendQuarryFromSlave(message)
        end
    end
end

local function runSlave()
    clearSlaveOutputs()

    local hardwareOk, hardwareError = checkSlaveHardware()

    if not hardwareOk then
        drawHardwareError("DRIVE1 SLAVE", hardwareError)
        return
    end

    openModem(SLAVE_WIRED_SIDE)

    local wirelessSide = findSlaveWireless()

    if not wirelessSide then
        drawHardwareError(
            "DRIVE1 SLAVE",
            "Drive1 requires a wireless modem for controller 2705."
        )
        return
    end

    openModem(wirelessSide)

    local state = loadSlaveState()

    state.boot = (state.boot or 0) + 1

    if
        state.tx and
        state.tx.executor == SLAVE_ID and
        state.tx.phase == "executing"
    then
        state.tx.phase = "complete"
        state.tx.recovered = true
    end

    saveSlaveState(state)
    logEvent(
        "INFO",
        "BOOT",
        "boot=" .. tostring(state.boot) ..
        " tx=" .. tostring(state.tx and state.tx.token or "none") ..
        " phase=" .. tostring(state.tx and state.tx.phase or "none")
    )

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE1 SLAVE")
    print("Release v" .. CAIRN_RELEASE)
    print("ID: " .. os.getComputerID())
    print("")
    print("Wired modem: bottom")
    print("Wireless relay: " .. wirelessSide)
    print("")
    print("Listening for controller 2705...")

    scanController(CONTROL_BOOT_WINDOW)

    term.setCursorPos(1, 9)
    term.clearLine()
    print("Waiting for Drive2 master...")

    while true do
        local sender, message, protocol = rednet.receive()

        if
            sender == CONTROL_ID and
            protocol == CONTROL_PROTOCOL and
            type(message) == "table"
        then
            relayControllerMessage(message)

        elseif
            protocol == QUARRY_PROTOCOL and
            type(message) == "table"
        then
            relayQuarryMessage(sender, message)

        elseif
            sender == MASTER_ID and
            protocol == LINK_PROTOCOL and
            type(message) == "table"
        then
            if message.type == "ping" then
                slaveReply(
                    state,
                    "pong",
                    message.token,
                    {
                        lastToken = state.tx and state.tx.token or nil,
                        lastPhase = state.tx and state.tx.phase or nil
                    }
                )

            elseif message.type == "prepare" then
                if
                    not state.tx or
                    state.tx.token ~= message.token
                then
                    state.tx = {
                        token = message.token,
                        direction = message.direction,
                        executor = message.executor,
                        phase = "prepared",
                        preparedBoot = state.boot
                    }

                    saveSlaveState(state)
                end

                slaveReply(
                    state,
                    "prepared",
                    message.token,
                    {
                        phase = state.tx.phase
                    }
                )

            elseif message.type == "tx_status" then
                slaveStatus(state, message.token)

            elseif message.type == "execute" then
                if
                    state.tx and
                    state.tx.token == message.token and
                    state.tx.executor == SLAVE_ID and
                    slaveMoves[message.direction]
                then
                    if state.tx.phase == "complete" then
                        slaveReply(
                            state,
                            "move_complete",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )

                    elseif state.tx.phase == "prepared" then
                        local move = slaveMoves[message.direction]

                        state.tx.phase = "executing"
                        saveSlaveState(state)

                        logEvent(
                            "INFO",
                            "SLAVE_PULSE_BEGIN",
                            "token=" .. tostring(message.token) ..
                            " direction=" .. tostring(message.direction) ..
                            " side=" .. tostring(move.side)
                        )

                        slaveReply(
                            state,
                            "execute_ack",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )

                        sleep(0.15)
                        clearSlaveOutputs()
                        redstone.setOutput(move.side, true)
                        sleep(PULSE_TIME)
                        redstone.setOutput(move.side, false)
                        sleep(MOVE_SETTLE_TIME)

                        state.tx.phase = "complete"
                        saveSlaveState(state)

                        logEvent(
                            "INFO",
                            "SLAVE_PULSE_COMPLETE",
                            "token=" .. tostring(message.token) ..
                            " direction=" .. tostring(message.direction)
                        )

                        slaveReply(
                            state,
                            "move_complete",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )

                    elseif state.tx.phase == "executing" then
                        slaveReply(
                            state,
                            "execute_ack",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )
                    end
                end

            elseif message.type == "commit" then
                if state.tx and state.tx.token == message.token then
                    state.tx = nil
                    saveSlaveState(state)
                end

                slaveReply(
                    state,
                    "commit_ack",
                    message.token
                )

            elseif message.type == "quarry_wireless" then
                sendQuarryFromSlave(message)

            elseif message.type == "diag_request" then
                slaveReply(
                    state,
                    "diag_reply",
                    message.token,
                    {
                        state = state,
                        peripherals = {
                            front = peripheral.getType("front"),
                            back = peripheral.getType("back"),
                            left = peripheral.getType("left"),
                            right = peripheral.getType("right"),
                            top = peripheral.getType("top"),
                            bottom = peripheral.getType("bottom")
                        },
                        outputs = {
                            front = redstone.getOutput("front"),
                            back = redstone.getOutput("back"),
                            left = redstone.getOutput("left"),
                            right = redstone.getOutput("right"),
                            top = redstone.getOutput("top"),
                            bottom = redstone.getOutput("bottom")
                        }
                    }
                )

            elseif message.type == "control_scan" then
                term.setCursorPos(1, 9)
                term.clearLine()
                print("Scanning controller 2705...")

                scanController(
                    tonumber(message.duration) or CONTROL_WINDOW
                )

                slaveReply(
                    state,
                    "control_scan_done",
                    message.token
                )

                term.setCursorPos(1, 9)
                term.clearLine()
                print("Waiting for Drive2 master...")

            elseif message.type == "control_reply" then
                forwardControllerReply(message)
            end

        elseif
            sender == MASTER_ID and
            protocol == UPDATE_PROTOCOL and
            type(message) == "table" and
            message.type == "update_begin"
        then
            local success, updateError = receiveRemoteUpdate(message)

            if not success then
                pcall(function()
                    rednet.send(MASTER_ID, {
                        type = "update_error",
                        session = message.session,
                        error = tostring(updateError)
                    }, UPDATE_PROTOCOL)
                end)

                if fs.exists("cairn_remote_stage") then
                    fs.delete("cairn_remote_stage")
                end
            end
        end
    end
end

local function runMain()
    clearMainOutputs()

    local hardwareOk, hardwareError = checkMainHardware()

    if not hardwareOk then
        drawHardwareError("DRIVE2 MASTER", hardwareError)
        return
    end

    openModem(MASTER_WIRED_SIDE)

    local state = loadMainState()

    if not state then
        state = initializeState()
    end

    logEvent(
        "INFO",
        "BOOT",
        "current=" .. positionText(state.current) ..
        " destination=" .. positionText(state.destination) ..
        " stage=" .. tostring(state.stage) ..
        " mode=" .. tostring(state.routeMode) ..
        " tx=" .. tostring(state.tx and state.tx.token or "none")
    )

    while true do
        receiveControlRelay(0.05)
        processControlQueue(state)
        processQuarryQueue(state)

        if pendingAction == "update" then
            pendingAction = nil
            shell.run("update")
        end

        if state.paused or not routeActive(state) then
            drawRoute(state)

            print("")

            if state.paused then
                print("PAUSED - waiting for controller 2705")
            else
                print("Waiting for controller 2705")
            end

            receiveControlRelay(0.45)
            processControlQueue(state)
            processQuarryQueue(state)

        else
            advanceTrip(state)
        end

        if pendingAction == "update" then
            pendingAction = nil
            shell.run("update")
        end

        sleep(0.02)
    end
end

local id = os.getComputerID()

migrateLegacyState()

if id == MASTER_ID then
    runMain()
elseif id == SLAVE_ID then
    runSlave()
else
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE")
    print("")
    print("Unexpected computer ID: " .. id)
    print("Expected Drive2 = 2700")
    print("Expected Drive1 = 2701")
end
