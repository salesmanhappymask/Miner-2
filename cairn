local LOG_DIR = "logs"
local LOG_CURRENT = "logs/current.log"
local LOG_ERRORS = "logs/errors.log"

local function ensureLogDir()
    if not fs.exists(LOG_DIR) then
        fs.makeDir(LOG_DIR)
    end
end

local function rotateLog(path, previous, limit)
    if fs.exists(path) and fs.getSize(path) >= limit then
        if fs.exists(previous) then
            fs.delete(previous)
        end
        fs.move(path, previous)
    end
end

local function appendLog(path, line)
    ensureLogDir()
    local h = fs.open(path, "a")
    if h then
        h.writeLine(line)
        h.close()
    end
end

local function logRole()
    local id = os.getComputerID()
    if id == MASTER_ID then
        return "drive2"
    elseif id == SLAVE_ID then
        return "drive1"
    end
    return "unknown"
end

local function logEvent(level, event, detail)
    rotateLog(LOG_CURRENT, "logs/previous.log", 65536)
    rotateLog(LOG_ERRORS, "logs/errors.previous.log", 32768)
    local line =
        "[" .. tostring(os.clock()) .. "] " ..
        "[v" .. tostring(CAIRN_RELEASE) .. "] " ..
        "[id=" .. tostring(os.getComputerID()) .. "] " ..
        "[role=" .. logRole() .. "] " ..
        "[" .. tostring(level) .. "] " ..
        "[" .. tostring(event) .. "] " ..
        tostring(detail or "")
    appendLog(LOG_CURRENT, line)
    if level == "ERROR" then
        appendLog(LOG_ERRORS, line)
    end
end

local function positionText(value)
    if type(value) ~= "table" then
        return "nil"
    end
    return
        tostring(value.x) .. "," ..
        tostring(value.y) .. "," ..
        tostring(value.z)
end

