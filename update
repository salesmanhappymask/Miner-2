local args = {...}

local RELEASE_VERSION = 33
local MASTER_ID = 2700
local SLAVE_ID = 2701

local BASE_URL = "https://raw.githubusercontent.com/salesmanhappymask/Cairn/main/"
local UPDATE_PROTOCOL = "cairn.drive.update"

local TEMP = "cairn_update_new"
local STAGE = "cairn_update_stage"
local VERSION_FILE = "cairn_version"
local STATE_FILE = "cairn_drive_state"
local FILES = {"startup", "cairn", "update", "push", "pushlogs"}
local CHUNK_SIZE = 3000

local LEGACY_VERSION_FILE = ".cairn_version"
local LEGACY_STATE_FILE = ".cairn_drive.tmp"

local MASTER_WIRED_SIDE = "left"

local SIDES = {
    "top",
    "bottom",
    "left",
    "right",
    "front",
    "back"
}


local function migrateLegacyFiles()
    if fs.exists(LEGACY_STATE_FILE) then
        if not fs.exists(STATE_FILE) then
            fs.move(LEGACY_STATE_FILE, STATE_FILE)
        else
            fs.delete(LEGACY_STATE_FILE)
        end
    end

    if fs.exists(LEGACY_VERSION_FILE) then
        if not fs.exists(VERSION_FILE) then
            fs.move(LEGACY_VERSION_FILE, VERSION_FILE)
        else
            fs.delete(LEGACY_VERSION_FILE)
        end
    end
end

local function readAll(path)
    if not fs.exists(path) then
        return nil
    end

    local h = fs.open(path, "r")
    if not h then
        return nil
    end

    local data = h.readAll()
    h.close()
    return data
end

local function writeAll(path, data)
    local h = fs.open(path, "w")
    if not h then
        return false
    end

    h.write(data)
    h.close()
    return true
end

local function releaseOf(name, data)
    local pattern

    if name == "update" then
        pattern = "local%s+RELEASE_VERSION%s*=%s*(%d+)"
    else
        pattern = "local%s+CAIRN_RELEASE%s*=%s*(%d+)"
    end

    local value = string.match(data, pattern)

    if not value then
        return nil
    end

    return tonumber(value)
end

local function fetch(name)
    if not http or not http.get then
        return nil, "HTTP API unavailable"
    end

    local token =
        tostring(os.getComputerID()) ..
        "_" ..
        tostring(math.floor(os.clock() * 1000))

    local ok, handle, err = pcall(
        http.get,
        BASE_URL .. name .. "?cairn=" .. token
    )

    if not ok then
        return nil, tostring(handle)
    end

    if not handle then
        return nil, tostring(err or "HTTP request failed")
    end

    local data = handle.readAll()
    handle.close()

    if not data or data == "" then
        return nil, "Empty response"
    end

    return data
end

local function validate(path)
    local fn, err = loadfile(path)

    if not fn then
        return false, err
    end

    return true
end

local function installed()
    local data = readAll(VERSION_FILE)

    if not data then
        return "unknown"
    end

    data = string.gsub(data, "%s+", "")

    if data == "" then
        return "unknown"
    end

    return data
end

local function openMasterWired()
    if peripheral.getType(MASTER_WIRED_SIDE) ~= "modem" then
        return nil, "Drive2 requires its wired modem on left"
    end

    local ok, wireless = pcall(
        peripheral.call,
        MASTER_WIRED_SIDE,
        "isWireless"
    )

    if not ok or wireless ~= false then
        return nil, "Drive2 left modem is not a wired modem"
    end

    if not rednet.isOpen(MASTER_WIRED_SIDE) then
        rednet.open(MASTER_WIRED_SIDE)
    end

    return MASTER_WIRED_SIDE
end

local function waitAck(session, stage, name, index, timeout)
    local deadline = os.clock() + timeout

    while os.clock() < deadline do
        local remaining = deadline - os.clock()
        local sender, message, protocol = rednet.receive(UPDATE_PROTOCOL, remaining)

        if not sender then
            return false, "timeout"
        end

        if sender == SLAVE_ID and type(message) == "table" then
            if message.type == "update_error" and message.session == session then
                return false, tostring(message.error or "Drive1 update error")
            end

            if message.type == "update_ack" and message.session == session then
                if message.stage == stage then
                    if name == nil or message.name == name then
                        if index == nil or message.index == index then
                            return true
                        end
                    end
                end
            end
        end
    end

    return false, "timeout"
end

local function pushSlave(files)
    local wiredSide, wiredError = openMasterWired()

    if not wiredSide then
        return false, wiredError or "Drive2 wired modem unavailable"
    end

    local session =
        tostring(os.getComputerID()) ..
        ":" ..
        tostring(RELEASE_VERSION) ..
        ":" ..
        tostring(math.floor(os.clock() * 1000))

    rednet.send(SLAVE_ID, {
        type = "update_begin",
        session = session,
        version = RELEASE_VERSION,
        files = FILES
    }, UPDATE_PROTOCOL)

    local ok, err = waitAck(session, "begin", nil, nil, 3)

    if not ok then
        return false, "Drive1 did not begin update: " .. tostring(err)
    end

    for _, name in ipairs(FILES) do
        rednet.send(SLAVE_ID, {
            type = "file_begin",
            session = session,
            name = name
        }, UPDATE_PROTOCOL)

        ok, err = waitAck(session, "file_begin", name, nil, 3)

        if not ok then
            return false, "Drive1 rejected " .. name .. ": " .. tostring(err)
        end

        local data = files[name]
        local index = 1
        local offset = 1

        while offset <= #data do
            local chunk = string.sub(data, offset, offset + CHUNK_SIZE - 1)

            rednet.send(SLAVE_ID, {
                type = "file_chunk",
                session = session,
                name = name,
                index = index,
                data = chunk
            }, UPDATE_PROTOCOL)

            ok, err = waitAck(session, "file_chunk", name, index, 3)

            if not ok then
                return false, "Drive1 chunk failed for " .. name .. ": " .. tostring(err)
            end

            offset = offset + CHUNK_SIZE
            index = index + 1
        end

        rednet.send(SLAVE_ID, {
            type = "file_end",
            session = session,
            name = name
        }, UPDATE_PROTOCOL)

        ok, err = waitAck(session, "file_end", name, nil, 3)

        if not ok then
            return false, "Drive1 validation failed for " .. name .. ": " .. tostring(err)
        end
    end

    rednet.send(SLAVE_ID, {
        type = "commit",
        session = session
    }, UPDATE_PROTOCOL)

    ok, err = waitAck(session, "commit", nil, nil, 3)

    if not ok then
        return false, "Drive1 commit failed: " .. tostring(err)
    end

    return true
end

local function stageRelease()
    if fs.exists(STAGE) then
        fs.delete(STAGE)
    end

    fs.makeDir(STAGE)

    local downloaded = {}

    for _, name in ipairs(FILES) do
        print("Downloading " .. name)

        local data, err = fetch(name)

        if not data then
            fs.delete(STAGE)
            return nil, "Download failed: " .. name .. ": " .. tostring(err or "")
        end

        local release = releaseOf(name, data)

        if release ~= RELEASE_VERSION then
            fs.delete(STAGE)
            return nil,
                "Release mismatch: " ..
                name ..
                " is v" ..
                tostring(release) ..
                ", expected v" ..
                RELEASE_VERSION
        end

        local path = fs.combine(STAGE, name)

        if not writeAll(path, data) then
            fs.delete(STAGE)
            return nil, "Could not stage " .. name
        end

        local ok, syntaxErr = validate(path)

        if not ok then
            fs.delete(STAGE)
            return nil, "Validation failed: " .. name .. ": " .. tostring(syntaxErr or "")
        end

        downloaded[name] = data
    end

    return downloaded
end

local function wipeWritableRoot(keep)
    keep = keep or {}
    local rootDrive = fs.getDrive("")

    for _, name in ipairs(fs.list("")) do
        local okDrive, drive = pcall(fs.getDrive, name)
        local writable = okDrive and drive == rootDrive and not fs.isReadOnly(name)

        if writable and not keep[name] then
            local ok, err = pcall(fs.delete, name)

            if not ok or fs.exists(name) then
                return false, "Could not clear " .. name .. ": " .. tostring(err or "delete failed")
            end
        end
    end

    return true
end

local function installStagedFollower()
    local wiped, wipeErr = wipeWritableRoot({
        [STAGE] = true,
        [TEMP] = true
    })

    if not wiped then
        error(wipeErr)
    end

    for _, name in ipairs(FILES) do
        local source = fs.combine(STAGE, name)
        fs.move(source, name)
    end

    if fs.exists(STAGE) then
        fs.delete(STAGE)
    end

    if fs.exists(TEMP) then
        fs.delete(TEMP)
    end

    writeAll(VERSION_FILE, tostring(RELEASE_VERSION))

    print("Drive1 bootstrap complete")
    print("Installed release: v" .. RELEASE_VERSION)
    print("Writable root was cleared before reinstalling.")
    print("Rebooting...")
    sleep(1)
    os.reboot()
end

local function slaveBootstrap()
    print("CAIRN Drive1 bootstrap/recovery")
    print("Installed release: v" .. installed())
    print("Checking GitHub...")

    local data, err = fetch("update")

    if not data then
        print("Updater download failed")
        print(err or "")
        return
    end

    local release = releaseOf("update", data)

    if not release then
        print("Downloaded updater has no release number")
        return
    end

    print("Downloaded updater release: v" .. release)

    if fs.exists(TEMP) then
        fs.delete(TEMP)
    end

    if not writeAll(TEMP, data) then
        print("Could not write temporary updater")
        return
    end

    local ok, syntaxErr = validate(TEMP)

    if not ok then
        fs.delete(TEMP)
        print("Downloaded updater failed validation")
        print(syntaxErr or "")
        return
    end

    print("Running slave bootstrap...")
    shell.run(TEMP, "--apply-slave")

    if fs.exists(TEMP) then
        fs.delete(TEMP)
    end
end

local function applySlave()
    if os.getComputerID() ~= SLAVE_ID then
        print("Slave bootstrap is only valid on Drive1 / 2701")
        return
    end

    print("Installing Drive1 release v" .. RELEASE_VERSION)

    local downloaded, err = stageRelease()

    if not downloaded then
        print(err or "Follower staging failed")
        return
    end

    print("All files verified as v" .. RELEASE_VERSION)
    installStagedFollower()
end

local function bootstrapMain()
    print("CAIRN updater")
    print("Installed release: v" .. installed())
    print("Checking GitHub...")

    local data, err = fetch("update")

    if not data then
        print("Updater download failed")
        print(err or "")
        return
    end

    local release = releaseOf("update", data)

    if not release then
        print("Downloaded updater has no release number")
        return
    end

    print("Downloaded updater release: v" .. release)

    if fs.exists(TEMP) then
        fs.delete(TEMP)
    end

    if not writeAll(TEMP, data) then
        print("Could not write temporary updater")
        return
    end

    local ok, syntaxErr = validate(TEMP)

    if not ok then
        fs.delete(TEMP)
        print("Downloaded updater failed validation")
        print(syntaxErr or "")
        return
    end

    print("Running downloaded updater...")
    shell.run(TEMP, "--apply")

    if fs.exists(TEMP) then
        fs.delete(TEMP)
    end
end

local function applyMain()
    print("Applying CAIRN release v" .. RELEASE_VERSION)

    local downloaded, err = stageRelease()

    if not downloaded then
        print(err or "Staging failed")
        return
    end

    print("All files verified as v" .. RELEASE_VERSION)
    print("Synchronizing Drive1 slave over wired link...")

    local pushed, pushErr = pushSlave(downloaded)

    if not pushed then
        fs.delete(STAGE)
        print("Drive1 synchronization failed")
        print(pushErr or "")
        print("Nothing was changed on Drive2")
        print("If Drive1 is not yet bootstrapped, run update on Drive1 once")
        return
    end

    print("Drive1 first synchronization complete")
    print("Waiting for Drive1 to reboot into v" .. RELEASE_VERSION .. "...")
    sleep(2)

    local cleanPushed = false
    local cleanError = nil

    for attempt = 1, 3 do
        print("Drive1 clean reinstall pass " .. tostring(attempt) .. "/3")
        cleanPushed, cleanError = pushSlave(downloaded)

        if cleanPushed then
            break
        end

        if attempt < 3 then
            sleep(1.5)
        end
    end

    if not cleanPushed then
        fs.delete(STAGE)
        print("Drive1 clean reinstall pass failed")
        print(cleanError or "")
        print("Nothing was changed on Drive2")
        return
    end

    print("Drive1 clean reinstall verified")
    print("Installing Drive2...")

    local wiped, wipeErr = wipeWritableRoot({
        [TEMP] = true,
        [STAGE] = true
    })

    if not wiped then
        fs.delete(STAGE)
        print("Drive2 clean reinstall failed")
        print(wipeErr or "")
        return
    end

    for _, name in ipairs(FILES) do
        local source = fs.combine(STAGE, name)

        if fs.exists(name) then
            fs.delete(name)
        end

        fs.move(source, name)
    end

    if fs.exists(STAGE) then
        fs.delete(STAGE)
    end

    if fs.exists(TEMP) then
        fs.delete(TEMP)
    end

    if not writeAll(VERSION_FILE, tostring(RELEASE_VERSION)) then
        print("Installed files but could not save version record")
        return
    end

    print("Drive2 synchronized")
    print("Writable root was cleared before reinstalling.")
    print("CAIRN update complete")
    print("Installed release: v" .. RELEASE_VERSION)
    print("Rebooting...")
    sleep(1)
    os.reboot()
end

local id = os.getComputerID()

migrateLegacyFiles()

if args[1] == "--apply" then
    if id ~= MASTER_ID then
        print("Main apply is only valid on Drive2 / 2700")
        return
    end

    applyMain()

elseif args[1] == "--apply-slave" then
    applySlave()

else
    if id == MASTER_ID then
        bootstrapMain()
    elseif id == SLAVE_ID then
        slaveBootstrap()
    else
        print("Unexpected computer ID: " .. id)
        print("Expected Drive2 = 2700")
        print("Expected Drive1 = 2701")
    end
end
